# Static single-point energy template — for ENCUT / KSPACING convergence tests (NSW=0)
# Usage: copy to the working directory, rename to INCAR, and modify ENCUT and KSPACING according to references/convergence_rules.md

SYSTEM = static single-point convergence test
PREC   = Accurate

# --- Convergence-test parameters (replace at each step) ---
ENCUT    = 450          # <-- replace step by step during the ENCUT scan
KSPACING = 0.15         # <-- may be fixed at a fairly dense value during the ENCUT stage; replace step by step during the KSPACING stage
KGAMMA   = .TRUE.

# --- Electronic parameters ---
ISMEAR = 0
SIGMA  = 0.05
EDIFF  = 1E-6
NELM   = 100

# --- Ionic steps: must be static ---
NSW    = 0
ISIF   = 2
IBRION = -1

# --- Output control ---
LWAVE  = .FALSE.
LCHARG = .FALSE.
