# ── Upstream LLM (only this group is needed) ─────────────────
# Just provide the API base URL and key. At startup the agent probes whether the upstream supports the Anthropic protocol:
#   supported     -> the SDK connects to the upstream directly; no proxy is started
#   not supported -> a protocol bridge is started inside the agent process and converts via the LiteLLM library, shared by sessions in the same process
LLM_API_BASE=https://api.example.com/v1
LLM_API_KEY=YOUR_API_KEY
LLM_MODEL=YOUR_MODEL_NAME

# ── Tool dependencies ────────────────────────────────────────
MP_API=YOUR_MP_API_KEY
SERPER_API_KEY=YOUR_SERPER_API_KEY
PMG_VASP_PSP_DIR=YOUR_POTCAR_DIR
